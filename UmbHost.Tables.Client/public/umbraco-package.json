{
  "$schema": "../../umbraco-package-schema.json",
  "id": "UmbHost.Tables",
  "name": "UmbHost Tables",
  "version": "18.0.0",
  "extensions": [
    {
      "type": "propertyEditorUi",
      "alias": "UmbHost.Tables.PropertyEditorUi",
      "name": "UmbHost Tables Property Editor UI",
      "element": "/App_Plugins/UmbHost.Tables/umbhost-tables.js",
      "elementName": "umbhost-table-property-editor",
      "meta": {
        "label": "Table",
        "icon": "icon-grid",
        "group": "rich content",
        "propertyEditorSchemaAlias": "UmbHost.Tables",
        "settings": {
          "properties": [
            {
              "alias": "showUseFirstRowAsHeader",
              "label": "Show 'Use First Row as Header' option",
              "description": "Allow editors to toggle whether the first row is a header row",
              "propertyEditorUiAlias": "Umb.PropertyEditorUi.Toggle"
            },
            {
              "alias": "showUseFirstColumnAsHeader",
              "label": "Show 'Use First Column as Header' option",
              "description": "Allow editors to toggle whether the first column is a header column",
              "propertyEditorUiAlias": "Umb.PropertyEditorUi.Toggle"
            },
            {
              "alias": "defaultRows",
              "label": "Default Rows",
              "description": "Number of rows for a new table (default: 3)",
              "propertyEditorUiAlias": "Umb.PropertyEditorUi.Integer"
            },
            {
              "alias": "defaultColumns",
              "label": "Default Columns",
              "description": "Number of columns for a new table (default: 3)",
              "propertyEditorUiAlias": "Umb.PropertyEditorUi.Integer"
            },
            {
              "alias": "minRows",
              "label": "Minimum Rows",
              "description": "Minimum number of rows allowed (default: 1)",
              "propertyEditorUiAlias": "Umb.PropertyEditorUi.Integer"
            },
            {
              "alias": "maxRows",
              "label": "Maximum Rows",
              "description": "Maximum number of rows allowed (0 = unlimited)",
              "propertyEditorUiAlias": "Umb.PropertyEditorUi.Integer"
            },
            {
              "alias": "minColumns",
              "label": "Minimum Columns",
              "description": "Minimum number of columns allowed (default: 1)",
              "propertyEditorUiAlias": "Umb.PropertyEditorUi.Integer"
            },
            {
              "alias": "maxColumns",
              "label": "Maximum Columns",
              "description": "Maximum number of columns allowed (0 = unlimited)",
              "propertyEditorUiAlias": "Umb.PropertyEditorUi.Integer"
            },
            {
              "alias": "enableRichText",
              "label": "Enable Rich Text",
              "description": "Allow rich text editing within cells",
              "propertyEditorUiAlias": "Umb.PropertyEditorUi.Toggle"
            },
            {
              "alias": "extensions",
              "label": "Rich Text Extensions",
              "description": "Select which Tiptap extensions (capabilities) are available in the cell editor",
              "propertyEditorUiAlias": "Umb.PropertyEditorUi.Tiptap.ExtensionsConfiguration"
            },
            {
              "alias": "toolbar",
              "label": "Rich Text Toolbar",
              "description": "Design the toolbar — only buttons whose required extensions are enabled above will appear",
              "propertyEditorUiAlias": "Umb.PropertyEditorUi.Tiptap.ToolbarConfiguration"
            },
            {
              "alias": "statusbar",
              "label": "Rich Text Status Bar",
              "description": "Design the status bar items for the cell editor",
              "propertyEditorUiAlias": "Umb.PropertyEditorUi.Tiptap.StatusbarConfiguration"
            },
            {
              "alias": "stylesheets",
              "label": "Rich Text Stylesheets",
              "description": "Stylesheets applied inside the cell editor",
              "propertyEditorUiAlias": "Umb.PropertyEditorUi.StylesheetPicker"
            },
            {
              "alias": "maxImageSize",
              "label": "Rich Text Max Image Size (px)",
              "description": "Maximum image size in pixels (default: 500)",
              "propertyEditorUiAlias": "Umb.PropertyEditorUi.Integer"
            }
          ],
          "defaultData": [
            { "alias": "showUseFirstRowAsHeader", "value": true },
            { "alias": "showUseFirstColumnAsHeader", "value": true },
            { "alias": "defaultRows", "value": 3 },
            { "alias": "defaultColumns", "value": 3 },
            { "alias": "minRows", "value": 1 },
            { "alias": "maxRows", "value": 0 },
            { "alias": "minColumns", "value": 1 },
            { "alias": "maxColumns", "value": 0 },
            { "alias": "enableRichText", "value": false },
            {
              "alias": "extensions",
              "value": [
                "Umb.Tiptap.Bold",
                "Umb.Tiptap.Italic",
                "Umb.Tiptap.Underline",
                "Umb.Tiptap.Strike",
                "Umb.Tiptap.Subscript",
                "Umb.Tiptap.Superscript",
                "Umb.Tiptap.TextAlign",
                "Umb.Tiptap.Link"
              ]
            },
            {
              "alias": "toolbar",
              "value": [[
                ["Umb.Tiptap.Toolbar.Bold", "Umb.Tiptap.Toolbar.Italic", "Umb.Tiptap.Toolbar.Underline", "Umb.Tiptap.Toolbar.Strike"],
                ["Umb.Tiptap.Toolbar.Subscript", "Umb.Tiptap.Toolbar.Superscript"],
                ["Umb.Tiptap.Toolbar.TextAlignLeft", "Umb.Tiptap.Toolbar.TextAlignCenter", "Umb.Tiptap.Toolbar.TextAlignRight"],
                ["Umb.Tiptap.Toolbar.Link", "Umb.Tiptap.Toolbar.Unlink"]
              ]]
            },
            { "alias": "statusbar", "value": [] },
            { "alias": "maxImageSize", "value": 500 }
          ]
        }
      }
    }
  ]
}
